{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0",
    "dev:e2e": "wrangler dev --ip 0.0.0.0 --port 8788 --var DATABASE_URL:postgres://paw:paw@localhost:5434/paw_mall_e2e",
    "lint": "eslint .",
    "typecheck": "tsc",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@paw-mall/shared": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261003.1",
    "@types/node": "^24.19.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  }
}
