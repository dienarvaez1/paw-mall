{
  "name": "mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start --go",
    "android": "expo start --go --android",
    "android:dev": "expo run:android",
    "emulator:location": "bash scripts/emulator-location.sh",
    "e2e": "maestro test .maestro --test-output-dir e2e-results --format junit --output e2e-results/report.xml",
    "e2e:api-down": "maestro test .maestro/api-down --test-output-dir e2e-results/api-down --format junit --output e2e-results/report-api-down.xml",
    "e2e:ios": "maestro test -e IOS=true -e APP_ID=host.exp.Exponent --exclude-tags android-only --test-output-dir e2e-results/ios --format junit --output e2e-results/report-ios.xml .maestro",
    "e2e:metro-ios": "EXPO_PUBLIC_API_URL=http://127.0.0.1:8788 expo start --go --port 8085",
    "e2e:metro": "EXPO_PUBLIC_API_URL=http://10.0.2.2:8788 expo start --dev-client --port 8084",
    "ios": "expo start --go --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc",
    "test": "vitest run",
    "i18n:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/i18n-check.mts"
  },
  "dependencies": {
    "@paw-mall/shared": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.104.1",
    "expo": "~57.0.26",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.20",
    "expo-dev-client": "~57.0.20",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-location": "~57.0.20",
    "expo-network": "~57.0.2",
    "expo-router": "~57.0.24",
    "expo-status-bar": "~57.0.1",
    "i18next": "^26.4.2",
    "nativewind": "^4.2.7",
    "react": "19.2.3",
    "react-i18next": "^17.0.15",
    "react-native": "0.86.3",
    "react-native-css-interop": "0.2.7",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-worklets": "0.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^57.0.13",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "eslint-plugin-i18next": "^6.1.5",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
