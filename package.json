{
  "name": "paw-mall",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "i18n:check": "pnpm --filter mobile i18n:check",
    "db:up": "docker compose up -d --build --wait",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter api db:generate",
    "db:migrate": "pnpm --filter api db:migrate",
    "places:import": "pnpm --filter @paw-mall/importers import:denue",
    "places:enrich-overture": "pnpm --filter @paw-mall/importers enrich-overture",
    "places:check-websites": "pnpm --filter @paw-mall/importers check-websites",
    "places:curated": "pnpm --filter @paw-mall/importers curated",
    "places:claims": "pnpm --filter @paw-mall/importers claims",
    "places:reports": "pnpm --filter @paw-mall/importers reports",
    "places:policies": "pnpm --filter @paw-mall/importers policies",
    "places:areas": "pnpm --filter @paw-mall/importers areas",
    "places:landmarks": "pnpm --filter @paw-mall/importers landmarks",
    "places:osm": "pnpm --filter @paw-mall/importers osm",
    "places:osm-hours": "pnpm --filter @paw-mall/importers osm-hours",
    "places:chains": "pnpm --filter @paw-mall/importers chains",
    "e2e:seed": "pnpm --filter @paw-mall/importers e2e-seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "prettier": "^3.9.9",
    "turbo": "^2.11.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
